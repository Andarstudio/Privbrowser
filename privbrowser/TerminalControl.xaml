<UserControl x:Class="PrivBrowser.TerminalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#09090B" Foreground="#22C55E" FontFamily="Consolas" FontSize="13">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ConsoleScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="ConsoleOutput" TextWrapping="Wrap"/>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="privbrowser> " Foreground="#3B82F6" VerticalAlignment="Center"/>
            <TextBox x:Name="InputBox" Grid.Column="1" Background="Transparent" Foreground="#22C55E"
                     BorderThickness="0" KeyDown="InputBox_KeyDown" CaretBrush="#22C55E"/>
        </Grid>
    </Grid>
</UserControl>