<Window x:Class="PrivBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrivBrowser" Height="800" Width="1200"
        Background="#1B1F1D" Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#26302B"/>
            <Setter Property="Foreground" Value="#E9EFEA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F1412"/>
            <Setter Property="Foreground" Value="#E9EFEA"/>
            <Setter Property="BorderBrush" Value="#3A473F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#E9EFEA"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Tab strip -->
        <DockPanel DockPanel.Dock="Top" Background="#12160F" LastChildFill="False">
            <ItemsControl x:Name="TabStrip" DockPanel.Dock="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button x:Name="NewTabButton" Content="+ New tab" DockPanel.Dock="Left" Click="NewTabButton_Click" Margin="4"/>
        </DockPanel>

        <!-- Toolbar -->
        <Grid DockPanel.Dock="Top" Margin="8,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="←" Click="Back_Click" Margin="0,0,4,0" Width="36"/>
            <Button Grid.Column="1" Content="→" Click="Forward_Click" Margin="0,0,4,0" Width="36"/>
            <Button Grid.Column="2" Content="⟳" Click="Reload_Click" Margin="0,0,8,0" Width="36"/>
            <TextBox Grid.Column="3" x:Name="AddressBar" VerticalContentAlignment="Center"
                     KeyDown="AddressBar_KeyDown"/>
            <Button Grid.Column="4" x:Name="BookmarkStarButton" Content="☆" Margin="8,0,0,0" Width="36"
                    Click="BookmarkStarButton_Click" ToolTip="Bookmark this page"/>
            <Button Grid.Column="5" Content="📑" Margin="4,0,0,0" Width="36"
                    Click="BookmarksButton_Click" ToolTip="Bookmarks"/>
            <Button Grid.Column="6" Content="🕘" Margin="4,0,0,0" Width="36"
                    Click="HistoryButton_Click" ToolTip="History"/>
            <Button Grid.Column="7" x:Name="ShieldButton" Content="🛡 0 blocked" Margin="8,0,0,0"
                    Click="ShieldButton_Click" ToolTip="View blocked trackers / allow this site"/>
            <Button Grid.Column="8" x:Name="VpnButton" Content="🌐 VPN: Off" Margin="4,0,0,0"
                    Click="VpnButton_Click" ToolTip="Configure VPN/proxy"/>
        </Grid>

        <!-- Page host -->
        <Grid x:Name="BrowserHost" Background="White"/>
    </DockPanel>
</Window>
