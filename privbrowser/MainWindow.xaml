<Window x:Class="PrivBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrivBrowser" Height="800" Width="1280"
        Background="#121212" Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1E1E" Padding="6" BorderBrush="#2C2C2C" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnBack" Content="◄" Width="32" Height="32" Margin="2" Click="BtnBack_Click" Background="#2A2A2A" Foreground="#FFF" BorderBrush="#333"/>
                    <Button x:Name="BtnForward" Content="►" Width="32" Height="32" Margin="2" Click="BtnForward_Click" Background="#2A2A2A" Foreground="#FFF" BorderBrush="#333"/>
                    <Button x:Name="BtnReload" Content="↻" Width="32" Height="32" Margin="2" Click="BtnReload_Click" Background="#2A2A2A" Foreground="#FFF" BorderBrush="#333"/>
                    <Button x:Name="BtnHome" Content="⌂" Width="32" Height="32" Margin="2" Click="BtnHome_Click" Background="#2A2A2A" Foreground="#FFF" BorderBrush="#333"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="8,0">
                    <TextBox x:Name="TxtAddressBar" Background="#2A2A2D" Foreground="#FFF" BorderBrush="#333" 
                             Padding="24,6,8,6" FontSize="14" VerticalAlignment="Center" 
                             KeyDown="TxtAddressBar_KeyDown"/>
                    <TextBlock x:Name="TxtSecurityIcon" Text="🔒" Foreground="#4CAF50" VerticalAlignment="Center" Margin="6,0,0,0" IsHitTestVisible="False"/>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnClearData" Content="🗑 Clear Data" Height="32" Padding="8,0" Margin="2" Click="BtnClearData_Click" Background="#2A2A2A" Foreground="#FF8A80" BorderBrush="#333"/>
                    <Button x:Name="BtnSettings" Content="⚙ Settings" Height="32" Padding="8,0" Margin="2" Click="BtnSettings_Click" Background="#2A2A2A" Foreground="#FFF" BorderBrush="#333"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#181818" Padding="4,4,4,0">
            <StackPanel Orientation="Horizontal">
                <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabControl_SelectionChanged">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Padding="4">
                                <TextBlock Text="{Binding Title}" MaxWidth="150" TextTrimming="CharacterEllipsis" Foreground="#DDD" VerticalAlignment="Center"/>
                                <Button Content="✕" Margin="8,0,0,0" Background="Transparent" Foreground="#888" BorderThickness="0" 
                                        Click="BtnCloseTab_Click" Tag="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>
                <Button Content="+" Width="28" Height="28" Margin="4,0" Click="BtnNewTab_Click" Background="#2A2A2A" Foreground="#FFF" BorderBrush="#333"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" x:Name="BrowserContainer"/>
    </Grid>
</Window>