<Window x:Class="PrivBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cef="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        xmlns:local="clr-namespace:PrivBrowser"
        Title="PrivBrowser" Height="768" Width="1280" Loaded="Window_Loaded"
        Icon="/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tab Bar -->
        <Grid Grid.Row="0" Background="#18181B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabControl_SelectionChanged">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding HeaderText}" VerticalAlignment="Center" Margin="0,0,8,0" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                            <Button Content="×" Padding="4,0" Background="Transparent" BorderThickness="0" Click="CloseTab_Click" Tag="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
            <Button Grid.Column="1" Content="+" Width="30" Margin="4" Click="NewTab_Click"/>
        </Grid>

        <!-- Navigation Bar -->
        <Grid Grid.Row="1" Background="#27272A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="5,0">
                <Button Content="←" Width="30" Click="Back_Click"/>
                <Button Content="→" Width="30" Click="Forward_Click"/>
                <Button Content="↻" Width="30" Click="Reload_Click"/>
            </StackPanel>

            <TextBox x:Name="UrlTextBox" Grid.Column="1" VerticalAlignment="Center" KeyDown="UrlTextBox_KeyDown" Margin="5,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="5,0">
                <Button Content="⚙" Width="30" Click="OpenSettings_Click"/>
                <Button Content=">_" Width="30" Click="ToggleTerminal_Click"/>
            </StackPanel>
        </Grid>

        <!-- Content Area -->
        <Grid Grid.Row="2" x:Name="BrowserContainer"/>

        <!-- Terminal View -->
        <Border Grid.Row="3">
            <Grid x:Name="TerminalContainer" Height="200" Visibility="Collapsed">
                <local:TerminalControl/>
            </Grid>
        </Border>
    </Grid>
</Window>